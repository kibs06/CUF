# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# API keys and secrets (never commit!)
dart_defines.json
*.env
nul

# Local backup secrets + outputs (see backup/README)
backup/config.ps1
backup/backups/
android/build/

# Obsidian local settings (vault notes themselves are committed)
.obsidian/

# Codebuff/Freebuff agent workspace (APK builds, screenshots, logs) — tooling, not source
.freebuff/

# Local agent/tooling state — installed skills, per-machine agent config and
# debug parity output. None of it is source the app builds from, and none of it
# should be published: it is regenerated per machine.
.agents/
.claude/
.parity/
skills-lock.json

# Freebuff session transcripts — a local record of one conversation, not
# documentation for the project.
freebuff-chat-*.md

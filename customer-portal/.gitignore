node_modules
dist
dist-ssr
*.local

# Generated by `npm run vendor:trackers` (also runs as predev/prebuild) —
# the MediaPipe wasm runtime copied from node_modules plus the downloaded
# pose model. Vercel regenerates it during the build.
public/vendor/

# Local env files — the Supabase URL and anon key are the same pair the Flutter
# app ships in lib/constants/app_constants.dart, but they are still per-deploy
# config here, so they are not committed.
.env
.env.*
!.env.example

.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Vercel CLI writes this when the project is linked; it names the account
# and the project, so it is not committed.
.vercel

        <mxCell id="t1" value="Home&#10;Featured shoes, search, and offers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="45" y="1850" width="300" height="110" as="geometry" /></mxCell>

<mxfile host="app.diagrams.net" agent="Codebuff" type="device">
  <diagram id="customer-signup-plain" name="Customer sign-up (plain English)">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="2060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="How a customer creates an account and starts shopping" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="45" y="8" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="legend" value="Legend&#10;Oval — the start and the finish&#10;Box — a step in the flow&#10;Diamond — a question (Yes or No)&#10;Dashed box — extra explanation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;dashed=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="8" width="290" height="150" as="geometry" /></mxCell>
        <mxCell id="start" value="Customer opens the app" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="d1" value="First time opening the app?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="160" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="welcome" value="Show the 3 welcome slides — they can skip them" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="172" width="280" height="66" as="geometry" /></mxCell>
        <mxCell id="screen" value="Show the Sign up / Sign in screen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="290" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="existing" value="Already have an account? They just sign in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="355" width="250" height="66" as="geometry" /></mxCell>
        <mxCell id="seller" value="Shop owners use a different form to apply" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="285" width="280" height="66" as="geometry" /></mxCell>
        <mxCell id="form" value="They fill in the Create Account form&#10;name  •  email  •  mobile number (optional)&#10;birthday  •  gender (optional)&#10;password  •  confirm the password&#10;they agree to the Terms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="385" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="d2" value="Is everything filled in correctly?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="550" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="fix" value="Show a message on the item that needs fixing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="562" width="250" height="66" as="geometry" /></mxCell>
        <mxCell id="d3" value="Is this email already used?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="dup" value="Tell them this email is already registered" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="712" width="280" height="66" as="geometry" /></mxCell>
        <mxCell id="create" value="Create the account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="840" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="d4" value="Do they confirm their email?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="945" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="noconfirm" value="No — this is not the usual setting, they are signed in right away" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="962" width="280" height="66" as="geometry" /></mxCell>
        <mxCell id="sendcode" value="We email them a 6-digit code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1100" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="d5" value="How do they confirm it?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="1205" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="code" value="They type the 6-digit code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="1180" width="280" height="56" as="geometry" /></mxCell>
        <mxCell id="emailbtn" value="They tap the button in the email" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="1265" width="280" height="56" as="geometry" /></mxCell>
        <mxCell id="badcode" value="The code is wrong or has expired — show an error, then let them send a new one" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="1173" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="back" value="They tap Back to sign in and stop here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="1217" width="250" height="66" as="geometry" /></mxCell>
        <mxCell id="confirmed" value="Account confirmed — the customer is signed in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1430" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="gates" value="Signing in also checks: new-phone code, fingerprint, locked screen, suspended account, extra code. New accounts skip these." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="1417" width="280" height="86" as="geometry" /></mxCell>
        <mxCell id="scanfail" value="If the scan fails, they land back here and can type it in or skip. Skipping is instant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="1640" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="foot" value="Optional step: add their foot size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1530" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="scan" value="Scan their feet with the phone camera" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1640" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="type" value="Type in their shoe size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="1640" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="skip" value="Skip this for now" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1640" width="280" height="60" as="geometry" /></mxCell>

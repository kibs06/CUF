          <mxGeometry x="410" y="793" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p5-code" value="We email a 6-digit code.&lt;br&gt;They type it to prove it is&lt;br&gt;really them. If the mail fails,&lt;br&gt;the reason shows on the&lt;br&gt;same screen." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;fontColor=#000000;" vertex="1" parent="1">

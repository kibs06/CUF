        <mxCell id="p5-creds" value="They type email and password.&lt;br&gt;Empty boxes or a short password&lt;br&gt;are flagged first." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="420" y="264" width="290" height="103" as="geometry" />
        </mxCell>
        <mxCell id="p5-forgot" value="Forgot password&lt;br&gt;tapped?" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;fontColor=#000000;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry x="410" y="409" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p5-resetlink" value="We email a link to set&lt;br&gt;a new one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=13;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="825" y="442" width="240" height="84" as="geometry" />

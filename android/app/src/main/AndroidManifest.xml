<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ARCore required: check Google Play for AR support -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- ARCore: the app requires ARCore (will be installed from Google Play if not present) -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required for push notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app self-update: lets the app trigger the system installer for
         its own downloaded APK (Android 8+ requires the user to grant this
         once per app via the "install unknown apps" settings toggle). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:label="CUFMAI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Disable Impeller renderer for emulator compatibility -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- Bundle the ML Kit OCR model so reference-number scanning works
             offline (no runtime model download needed). -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link: return from the GCash redirect (solvision://checkout/gcash) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="solvision" android:host="checkout" android:pathPrefix="/gcash"/>
            </intent-filter>
            <!-- Deep links: the two e-mail returns, both on solvision://auth.
                 The confirmation button (solvision://auth/confirm) and the
                 password-reset button (solvision://auth/recovery) share this
                 one filter because Android matches a cross-product of the
                 <data> elements below — two paths, one declaration.

                 Each path must match its Dart constant EXACTLY
                 (DeepLinkService.authConfirmRedirect /
                 authRecoveryRedirect) or that e-mail button opens a browser
                 instead of the app. Both are also allow-listed in the LIVE
                 project (Authentication → URL Configuration → Redirect URLs),
                 written by tool/apply_live_auth_mail.dart. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="solvision" android:host="auth" android:pathPrefix="/confirm"/>
                <data android:scheme="solvision" android:host="auth" android:pathPrefix="/recovery"/>
            </intent-filter>
            <!-- App Links for product shares (Phase B — DISABLED until a
                 custom domain exists). Shared product links open the app
                 directly to ProductDetailScreen.

                 To activate:
                 1. Replace YOUR-DOMAIN.com with the real domain and set
                    android:autoVerify="true".
                 2. Host the file below at https://YOUR-DOMAIN.com/.well-known/assetlinks.json
                    (source: web/.well-known/assetlinks.json in this repo)
                    with the real signing-cert SHA-256 fingerprint from:
                    keytool -list -v -keystore <keystore> -alias <alias> | grep SHA256
                 3. Reinstall the app (autoVerify only runs on fresh install)
                    and confirm verification with:
                    adb shell pm verify-app-links (pass the re-verify flag) com.solevision.app
                 See docs/AI/SHARE_PRODUCT_ARCHITECTURE.md.
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="YOUR-DOMAIN.com" android:pathPrefix="/p"/>
            </intent-filter>
            -->
        </activity>
        <!-- Seller home-screen widget.

             `android:name` must stay in step with
             `SellerWidgetService.androidWidgetName` (Dart) — home_widget resolves
             the provider as <package>.<name> when the app pushes a redraw, and a
             mismatch fails at runtime with PlatformException(-8) rather than at
             build time.

             exported="false": the AppWidgetManager addresses this receiver
             explicitly, so nothing outside the app needs to reach it. -->
        <receiver
            android:name=".SellerWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/seller_widget_info" />
        </receiver>

        <!-- Facebook Login (social sign-in). App ID / client token come from
             @string/facebook_app_id / @string/facebook_client_token — replace
             the placeholders per docs/SOCIAL_SIGNIN_SETUP.md. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <activity
            android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:exported="true" />
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>
        <!-- Authorities end with the real app ID, matching @string/facebook_app_id
             above — see docs/SOCIAL_SIGNIN_SETUP.md. -->
        <provider
            android:name="com.facebook.FacebookContentProvider"
            android:authorities="com.facebook.app.FacebookContentProvider28489991990701177"
            android:exported="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- ARCore: required for AR features. Placed inside <application> per ARCore docs.
             tools:replace is required because SceneView (the virtual-fitting renderer)
             declares the same key as "optional" in its own manifest; without this the
             manifest merger fails. "required" is the app's existing intent — the foot
             scan needs ARCore — so the app's value wins. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required"
            tools:replace="android:value" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Required for ARCore availability check on Android 11+ (package visibility) -->
        <package android:name="com.google.ar.core" />
        <!-- Facebook Login needs to see the Facebook app + Custom Tabs browser -->
        <package android:name="com.facebook.katana" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
